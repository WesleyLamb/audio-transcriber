{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome"]
  },
  "include": [
    "entrypoints/**/*",
    "utils/**/*",
    "types/**/*",
    ".wxt/types/**/*",
    "wxt.config.ts"
  ]
}
