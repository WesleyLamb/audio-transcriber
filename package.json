{
  "name": "audio-transcriber",
  "version": "1.0.0",
  "description": "Extensão para transcrição local e privada de áudios no WhatsApp Web utilizando Transformers.js e Whisper",
  "type": "module",
  "license": "MIT",
  "author": "Wesley Lamb",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "copy:wasm": "mkdir -p public/wasm && cp node_modules/onnxruntime-web/dist/ort-wasm* public/wasm/"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
